{
  "name": "hssh-fcalc",
  "productName": "HSSH FCalc",
  "version": "1.0.0",
  "description": "Freight density and NMFC class estimator for LTL shipments.",
  "author": "HSSH",
  "private": true,
  "license": "UNLICENSED",
  "main": "electron/main.js",
  "scripts": {
    "test": "node --test tests/calc.test.js",
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.hssh.fcalc",
    "productName": "HSSH FCalc",
    "copyright": "Copyright © 2026 HSSH",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "assets/**",
      "electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.business",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "HSSH-FCalc-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "HSSH-FCalc-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "HSSH-FCalc-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
